<!-- MIUI ADD: Adapt_MIUIAdaptFrame-->
<displayConfiguration>
    <!-- Global Brightness-Nit mapping -->
    <screenBrightnessMap>
        <point>
            <value>0.000854597</value>
            <nits>2.0</nits>
        </point>
        <point>
            <value>0.499938</value>
            <nits>500.0</nits>
        </point>
        <point>
            <value>0.699914540</value>
            <nits>700.0</nits>
        </point>
        <point>
            <value>0.739576</value>
            <nits>810.0</nits>
        </point>
        <point>
            <value>0.808082041</value>
            <nits>1000.0</nits>
        </point>
        <point>
            <value>0.953577</value>
            <nits>1440.0</nits>
        </point>
        <point>
            <value>1.0</value>
            <nits>3000.0</nits>
        </point>
    </screenBrightnessMap>
    <!-- root node for HBM-->
    <highBrightnessMode enabled="true">
        <!-- Transition point brightness from normal (manual max) to HBM mode (810 nits) -->
        <transitionPoint>0.739576</transitionPoint>
        <!-- Minimum lux to enter HBM (sunlight) -->
        <minimumLux>5882</minimumLux>
        <!-- Time limitation for HBM: non-zero window locks manual slider strictly to transitionPoint (810 nits) -->
        <timing>
            <timeWindowSecs>1800</timeWindowSecs>
            <timeMaxSecs>300</timeMaxSecs>
            <timeMinSecs>60</timeMinSecs>
        </timing>
        <!--Refresh rate limitation when the device is in HBM -->
        <!-- <refreshRate>
        <minimum>0</minimum>
        <maximum>0</maximum>
        </refreshRate> -->
        <!-- Thermal limitation for HBM -->
        <thermalStatusLimit>critical</thermalStatusLimit>
        <!-- Low power mode limitation for HBM -->
        <allowInLowPowerMode>true</allowInLowPowerMode>
        <minimumHdrPercentOfScreen>0</minimumHdrPercentOfScreen>
        <sdrHdrRatioMap>
            <point>
                <sdrNits>2.0</sdrNits>
                <hdrRatio>5.3</hdrRatio>
            </point>
            <point>
                <sdrNits>1440.0</sdrNits>
                <hdrRatio>2.08</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>
    <screenBrightnessRampFastDecrease>0.41590282</screenBrightnessRampFastDecrease>
    <screenBrightnessRampFastIncrease>0.41590282</screenBrightnessRampFastIncrease>
    <screenBrightnessRampSlowDecrease>0.11764706</screenBrightnessRampSlowDecrease>
    <screenBrightnessRampSlowIncrease>0.11764706</screenBrightnessRampSlowIncrease>
    <ambientLightHorizonLong>3000</ambientLightHorizonLong>
    <ambientLightHorizonShort>1000</ambientLightHorizonShort>
</displayConfiguration>
